<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <style>
    *{
        border: 3px solid purple;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;

    }

    .navbar{

    background-color: black;
    padding: 15px;
    justify-content: center;
    align-items: center;

    }
    .fotonome{
    width: 200px;
    height: 200px;
    justify-content: center;
    align-items: center;
    }
    
    .profile-img{

        width: 200px;
        height: 200px;
        border-radius: 50%;
        border: 5px solid blue;
    }
    .nome{
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif;

    }


    </style>
    <div class="navbar">
        <a href="home">home</a>
        <a href="contanto">contato</a>      
         </div>
         <div class="fotonome">
        <img class="profile-img" src="data:image/jpeg;base64,"
         </div>
         <div class="nome">
        <h1>messi x cristiano </h1>
        
            
         </div>

</body>
</html>
